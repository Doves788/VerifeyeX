# ==============================================================================
# VERIFEYEX AI ENGINE - SECURE ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- 1. CORE SECURITY ---
# Secret key for signing and verifying JWT authentication tokens
JWT_SECRET_KEY="generate-a-strong-256-bit-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- 2. CORS & NETWORK SECURITY ---
# Strict list of allowed frontend origins (No wildcards in production)
ALLOWED_ORIGINS="https://app.verifeyex.com,http://localhost:5173"

# --- 3. DATABASE (VECTOR & RELATIONAL) ---
POSTGRES_URL="postgresql://user:password@localhost:5432/verifeyex"
QDRANT_VECTOR_DB_URL="http://localhost:6333"
QDRANT_API_KEY="your-qdrant-secure-api-key"

# --- 4. RATE LIMITING & WAF ---
RATE_LIMIT_REQUESTS_PER_MINUTE=100
REDIS_CACHE_URL="redis://localhost:6379/0"

# --- 5. OPENROUTER & LLM HONEYPOT ---
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
LLM_MODEL="meta-llama/llama-3-70b-instruct"

